{
  "name": "xiangqi-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @xiangqi/web dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @xiangqi/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "server": "pnpm --filter @xiangqi/server start",
    "test:online": "node scripts/online-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
